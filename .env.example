# ---------------------------------------------------------------------------
# TJD Labs — environment variables
#
# 1. Copy this file to ".env" (which is git-ignored) in the project root.
# 2. Fill in the values from your Firebase project settings
#    (Project settings -> General -> Your apps -> SDK setup and configuration).
# 3. Set VITE_USE_FIREBASE=true once your Firestore collections are populated
#    (see src/data for the expected shape). Until then the site runs entirely
#    on the local mock data, so it works with zero configuration.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=

# Toggle live Firestore data on/off. Defaults to "false" (mock data) when unset.
VITE_USE_FIREBASE=false

# Optional: used by the GitHub activity card on the homepage.
VITE_GITHUB_ORG=tjd-labs
